<script>
// ── LOADER
const loader = document.getElementById('loader');
const pctEl = document.getElementById('loader-pct');
let p = 0;
const tick = setInterval(() => {
  p = Math.min(p + Math.random() * 10, 100);
  pctEl.textContent = Math.floor(p) + '%';
  if (p >= 100) { clearInterval(tick); setTimeout(() => loader.classList.add('hidden'), 400); }
}, 70);

// ── SCROLL PROGRESS
window.addEventListener('scroll', () => {
  const max = document.body.scrollHeight - innerHeight;
  document.getElementById('progress').style.width = (scrollY / max * 100) + '%';
});

// ── THREE.JS SCENE
const container = document.getElementById('canvas-container');
const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x080407, 0.016);

const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.1, 200);
camera.position.z = 28;

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setClearColor(0x000000, 0);
container.appendChild(renderer.domElement);

// Lights — red palette
const ambient = new THREE.AmbientLight(0x220005, 1.2);
scene.add(ambient);
const pL1 = new THREE.PointLight(0xff1111, 6, 80); pL1.position.set(18, 15, 8); scene.add(pL1);
const pL2 = new THREE.PointLight(0x8b0000, 4, 60); pL2.position.set(-18, -12, 6); scene.add(pL2);
const pL3 = new THREE.PointLight(0xff4400, 3, 50); pL3.position.set(0, -18, 16); scene.add(pL3);
const pL4 = new THREE.PointLight(0xff0000, 2, 40); pL4.position.set(-8, 20, -10); scene.add(pL4);

// Particles
const pCount = 3000, pPos = new Float32Array(pCount * 3);
for (let i = 0; i < pCount; i++) {
  pPos[i*3] = (Math.random()-.5)*130; pPos[i*3+1] = (Math.random()-.5)*130; pPos[i*3+2] = (Math.random()-.5)*90;
}
const pGeo = new THREE.BufferGeometry();
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
const stars = new THREE.Points(pGeo, new THREE.PointsMaterial({ color: 0xff2233, size: .1, transparent: true, opacity: .28, sizeAttenuation: true }));
scene.add(stars);

// Central torus knot
const kGeo = new THREE.TorusKnotGeometry(7, 2.2, 200, 28, 3, 4);
const knot = new THREE.Mesh(kGeo, new THREE.MeshPhongMaterial({ color: 0x1a0005, emissive: 0x3d0008, specular: 0xff2233, shininess: 150, transparent: true, opacity: .9 }));
scene.add(knot);
const kWire = new THREE.Mesh(kGeo, new THREE.MeshBasicMaterial({ color: 0xe8000a, wireframe: true, transparent: true, opacity: .07 }));
scene.add(kWire);

// Outer orbiting knot
const k2 = new THREE.Mesh(
  new THREE.TorusKnotGeometry(10, .4, 150, 12, 2, 5),
  new THREE.MeshBasicMaterial({ color: 0x8b0000, wireframe: true, transparent: true, opacity: .15 })
);
scene.add(k2);

// Rings
function mkRing(r, tube, col, op, rx, ry) {
  const m = new THREE.Mesh(new THREE.TorusGeometry(r, tube, 8, 100), new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: op }));
  m.rotation.x = rx; m.rotation.y = ry; scene.add(m); return m;
}
const ring1 = mkRing(14, .06, 0xe8000a, .15, Math.PI/2.5, 0);
const ring2 = mkRing(19, .04, 0xff4500, .08, Math.PI/3.2, Math.PI/5);
const ring3 = mkRing(22, .03, 0xaa0000, .05, Math.PI/1.8, Math.PI/3);

// Floating octahedra
const shards = [];
[
  {s:2.0,x:17,y:8,z:-4,c:0xff1111,sp:.7},{s:1.2,x:-19,y:-7,z:3,c:0xff4400,sp:.9},
  {s:2.8,x:-13,y:13,z:-9,c:0x8b0000,sp:.5},{s:.9,x:21,y:-13,z:4,c:0xff2233,sp:1.1},
  {s:1.5,x:5,y:-17,z:-7,c:0xcc0000,sp:.6},{s:1.1,x:-6,y:17,z:3,c:0xff3300,sp:.8},
].forEach(d => {
  const mesh = new THREE.Mesh(
    new THREE.OctahedronGeometry(d.s, 0),
    new THREE.MeshPhongMaterial({ color: d.c, emissive: d.c, emissiveIntensity:.25, wireframe: true, transparent: true, opacity:.7 })
  );
  mesh.position.set(d.x, d.y, d.z);
  mesh.userData = { ox: d.x, oy: d.y, sp: d.sp, ph: Math.random()*Math.PI*2 };
  scene.add(mesh); shards.push(mesh);
});

// DNA helix
const helix = [];
for (let i = 0; i < 24; i++) {
  const ang = (i/24)*Math.PI*4;
  const m = new THREE.Mesh(
    new THREE.SphereGeometry(.25, 8, 8),
    new THREE.MeshPhongMaterial({ color: 0xff0000, emissive: 0x660000, emissiveIntensity:.4, transparent: true, opacity:.5 })
  );
  m.position.set(Math.cos(ang)*12, (i/24)*28-14, Math.sin(ang)*12);
  m.userData = { ang, r: 12 };
  scene.add(m); helix.push(m);
}

// Mouse / scroll
let mx = 0, my = 0, tRX = 0, tRY = 0;
window.addEventListener('mousemove', e => { mx = (e.clientX/innerWidth-.5)*2; my = (e.clientY/innerHeight-.5)*2; });

// Animate
const clock = new THREE.Clock();
(function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();

  tRY += (mx*.3 - tRY) * .04;
  tRX += (my*.2 - tRX) * .04;

  knot.rotation.x = tRX + t*.1; knot.rotation.y = tRY + t*.15; knot.rotation.z = t*.06;
  kWire.rotation.copy(knot.rotation);

  k2.rotation.x = -tRX + t*.08; k2.rotation.y = tRY - t*.12; k2.rotation.z = t*.05;

  camera.position.y = -scrollY * .01;
  camera.position.x = mx * 1.2;

  stars.rotation.y = t * .015; stars.rotation.x = t * .006;
  ring1.rotation.z = t*.05;
  ring2.rotation.y = t*.04; ring2.rotation.z = -t*.03;
  ring3.rotation.x = t*.03 + Math.PI/1.8; ring3.rotation.z = t*.02;

  shards.forEach(f => {
    const d = f.userData;
    f.position.y = d.oy + Math.sin(t*d.sp + d.ph)*2.5;
    f.position.x = d.ox + Math.cos(t*d.sp*.7 + d.ph)*1.5;
    f.rotation.x = t*.5*d.sp; f.rotation.z = t*.3*d.sp;
  });

  helix.forEach(s => {
    const a = s.userData.ang + t*.3;
    s.position.x = Math.cos(a)*s.userData.r;
    s.position.z = Math.sin(a)*s.userData.r;
  });

  pL1.intensity = 5 + Math.sin(t*1.1)*2;
  pL2.intensity = 3.5 + Math.cos(t*.8)*1.5;
  pL3.intensity = 2.5 + Math.sin(t*1.4)*1;

  renderer.render(scene, camera);
})();

window.addEventListener('resize', () => {
  camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

// ── CURSOR
const cur = document.getElementById('cursor'), curR = document.getElementById('cursor-ring');
let cx = 0, cy = 0, rx = 0, ry = 0;
document.addEventListener('mousemove', e => { cx = e.clientX; cy = e.clientY; });
(function moveCursor() {
  cur.style.left = cx+'px'; cur.style.top = cy+'px';
  rx += (cx-rx)*.1; ry += (cy-ry)*.1;
  curR.style.left = rx+'px'; curR.style.top = ry+'px';
  requestAnimationFrame(moveCursor);
})();
document.querySelectorAll('a,button,.project-card,.stat-box,.service-card,.process-step,.testimonial').forEach(el => {
  el.addEventListener('mouseenter', () => { cur.style.width='22px'; cur.style.height='22px'; curR.style.width='66px'; curR.style.height='66px'; });
  el.addEventListener('mouseleave', () => { cur.style.width='10px'; cur.style.height='10px'; curR.style.width='38px'; curR.style.height='38px'; });
});

// ── SCROLL REVEAL
new IntersectionObserver((entries) => {
  entries.forEach((e, i) => { if (e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i*80); });
}, { threshold: .12 }).observe ? (() => {
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => { if (e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i*80); });
  }, { threshold: .12 });
  document.querySelectorAll('.reveal').forEach(r => io.observe(r));
})() : null;

// ── CONTACT FORM
document.getElementById('submitBtn').addEventListener('click', () => {
  const btn = document.getElementById('submitBtn');
  btn.innerHTML = '<span>Message Sent ✓</span>';
  btn.style.background = '#8b0000';
  setTimeout(() => { btn.innerHTML = '<span>Send Message →</span>'; btn.style.background = ''; }, 3000);
});
</script>
