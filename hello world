<style>
:root {
  --ink: #080407;
  --paper: #f5e6e0;
  --red: #e8000a;
  --red2: #ff2233;
  --red3: #ff6666;
  --crimson: #8b0000;
  --orange: #ff4500;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  background: var(--ink);
  color: var(--paper);
  font-family: 'DM Mono', monospace;
  overflow-x: hidden;
  cursor: none;
}

/* CURSOR */
#cursor {
  position: fixed; width: 10px; height: 10px;
  background: var(--red2); border-radius: 50%;
  pointer-events: none; z-index: 9999;
  transform: translate(-50%,-50%);
  transition: width .2s, height .2s;
  mix-blend-mode: screen;
}
#cursor-ring {
  position: fixed; width: 38px; height: 38px;
  border: 1px solid rgba(255,34,51,0.5); border-radius: 50%;
  pointer-events: none; z-index: 9998;
  transform: translate(-50%,-50%);
  transition: width .3s, height .3s;
}

/* CANVAS */
#canvas-container { position: fixed; inset: 0; z-index: 0; }

/* NOISE */
body::after {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 998; opacity: 0.7;
}

/* SCANLINES */
body::before {
  content: '';
  position: fixed; inset: 0;
  background: repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.03) 2px,rgba(0,0,0,0.03) 4px);
  pointer-events: none; z-index: 997;
}

/* PROGRESS BAR */
#progress {
  position: fixed; top: 0; left: 0; height: 2px;
  background: linear-gradient(90deg,var(--crimson),var(--red2),var(--orange));
  z-index: 1000; width: 0; transition: width .1s;
}

/* NAV */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 500;
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.8rem 3rem;
  backdrop-filter: blur(12px);
  background: rgba(8,4,7,0.65);
  border-bottom: 1px solid rgba(232,0,10,0.12);
  animation: fadeDown .8s ease .2s both;
}
.logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.8rem; letter-spacing: .4em; color: var(--paper);
}
.logo span { color: var(--red2); }
.nav-links { display: flex; gap: 2.5rem; list-style: none; }
.nav-links a {
  color: var(--paper); text-decoration: none;
  font-size: .65rem; letter-spacing: .2em; text-transform: uppercase;
  opacity: .5; transition: opacity .3s, color .3s;
  position: relative;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: -4px; left: 0;
  width: 0; height: 1px; background: var(--red2); transition: width .3s;
}
.nav-links a:hover { opacity: 1; color: var(--red3); }
.nav-links a:hover::after { width: 100%; }
.nav-cta {
  padding: .55rem 1.4rem;
  border: 1px solid var(--red2); color: var(--red2)!important; opacity: 1!important;
}
.nav-cta:hover { background: var(--red2)!important; color: var(--ink)!important; }
.nav-cta::after { display: none!important; }

/* LOADER */
#loader {
  position: fixed; inset: 0; z-index: 9000;
  background: var(--ink);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  transition: opacity .8s, visibility .8s;
}
#loader.hidden { opacity: 0; visibility: hidden; }
.loader-logo {
  font-family: 'Bebas Neue', sans-serif; font-size: 5rem; letter-spacing: .4em;
  color: var(--red2); animation: pulse 1s ease-in-out infinite;
}
.loader-bar-wrap {
  width: 200px; height: 2px; background: rgba(255,255,255,0.05); margin-top: 2rem; overflow: hidden;
}
.loader-bar {
  height: 100%; width: 0;
  background: linear-gradient(90deg,var(--crimson),var(--red2),var(--orange));
  animation: loadBar 2s ease forwards;
}
.loader-pct { font-size: .6rem; letter-spacing: .3em; color: var(--red3); margin-top: 1rem; opacity: .6; }

/* HERO */
#hero {
  position: relative; z-index: 10; min-height: 100vh;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 4rem 3rem; pointer-events: none;
}
.hero-label {
  font-size: .65rem; letter-spacing: .35em; text-transform: uppercase;
  color: var(--red3); margin-bottom: 1.5rem;
  animation: fadeUp 1s ease 2.4s both;
}
.hero-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(5rem, 13vw, 14rem);
  line-height: .86; letter-spacing: -.02em;
  animation: fadeUp 1s ease 2.6s both;
}
.hero-title .outline { -webkit-text-stroke: 1.5px var(--red2); color: transparent; display: block; }
.hero-title .filled { color: var(--paper); display: block; }
.hero-title .red { color: var(--red2); display: block; }
.hero-sub {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-top: 3rem; animation: fadeUp 1s ease 2.8s both;
}
.hero-desc { font-size: .75rem; line-height: 1.9; opacity: .45; max-width: 260px; }
.hero-cta {
  display: inline-flex; align-items: center; gap: 1rem;
  padding: 1rem 2.2rem; background: var(--red); border: none;
  color: var(--paper); font-family: 'DM Mono', monospace;
  font-size: .7rem; letter-spacing: .2em; text-transform: uppercase;
  text-decoration: none; pointer-events: all; cursor: none;
  position: relative; overflow: hidden; transition: transform .2s;
}
.hero-cta::before {
  content: ''; position: absolute; inset: 0; background: var(--red2);
  transform: translateX(-101%); transition: transform .4s ease;
}
.hero-cta:hover::before { transform: translateX(0); }
.hero-cta span, .hero-cta::after { position: relative; z-index: 1; }
.hero-cta::after { content: '→'; }

/* MARQUEE */
.marquee-wrap {
  position: relative; z-index: 10; overflow: hidden;
  border-top: 1px solid rgba(232,0,10,0.15);
  border-bottom: 1px solid rgba(232,0,10,0.15);
  background: rgba(8,4,7,0.75); padding: 1rem 0;
}
.marquee-track { display: flex; white-space: nowrap; animation: marquee 20s linear infinite; }
.marquee-item {
  font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: .3em;
  padding: 0 2rem; color: var(--red3); opacity: .4; flex-shrink: 0;
}
.marquee-dot { color: var(--red2); opacity: .8; }

/* SECTIONS */
.section {
  position: relative; z-index: 10; min-height: 100vh; padding: 8rem 3rem;
  background: rgba(8,4,7,0.6); backdrop-filter: blur(2px);
}
.section-label { font-size: .6rem; letter-spacing: .35em; text-transform: uppercase; color: var(--red2); margin-bottom: 2rem; opacity: .7; }
.section-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem,6vw,7rem); line-height: .95; letter-spacing: .03em; }
.section-title em { color: var(--red2); font-style: normal; }

/* ABOUT */
#about { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
.about-text { font-size: .82rem; line-height: 2.1; opacity: .55; margin-top: 2rem; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
.stat-box {
  background: rgba(15,5,10,0.8); border: 1px solid rgba(232,0,10,0.1);
  padding: 2.5rem 2rem; transition: border-color .4s, background .4s;
  position: relative; overflow: hidden;
}
.stat-box::before {
  content: ''; position: absolute; bottom: 0; left: 0;
  height: 2px; width: 0; background: var(--red2); transition: width .5s;
}
.stat-box:hover { border-color: rgba(232,0,10,0.35); background: rgba(232,0,10,0.04); }
.stat-box:hover::before { width: 100%; }
.stat-number { font-family: 'Bebas Neue', sans-serif; font-size: 3.8rem; color: var(--red2); display: block; }
.stat-label { font-size: .58rem; letter-spacing: .25em; text-transform: uppercase; opacity: .35; margin-top: .5rem; }

/* SERVICES */
#services { background: rgba(12,3,7,0.8); }
.services-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; margin-top: 4rem; border: 1px solid rgba(232,0,10,0.08); }
.service-card {
  padding: 3rem 2rem; border-right: 1px solid rgba(232,0,10,0.08);
  background: rgba(8,4,7,0.7); position: relative; overflow: hidden; transition: background .4s;
}
.service-card:last-child { border-right: none; }
.service-card::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 50% 100%,rgba(232,0,10,0.12) 0%,transparent 70%);
  opacity: 0; transition: opacity .4s;
}
.service-card:hover { background: rgba(20,5,10,0.95); }
.service-card:hover::after { opacity: 1; }
.service-icon {
  width: 48px; height: 48px; border: 1px solid rgba(232,0,10,0.3);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 2rem; font-size: 1.2rem; color: var(--red2);
  transition: border-color .3s, background .3s;
}
.service-card:hover .service-icon { background: rgba(232,0,10,0.1); border-color: var(--red2); }
.service-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: .05em; margin-bottom: 1rem; }
.service-desc { font-size: .7rem; line-height: 1.9; opacity: .4; }

/* WORK */
#work { min-height: auto; }
.work-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 4rem; }
.projects-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; }
.project-card {
  background: rgba(10,4,8,0.7); border: 1px solid rgba(232,0,10,0.07);
  padding: 3rem 2rem; position: relative; overflow: hidden; cursor: none;
  transition: border-color .4s;
}
.project-card::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg,rgba(232,0,10,0.07) 0%,transparent 60%);
  opacity: 0; transition: opacity .5s;
}
.project-card::after {
  content: ''; position: absolute; bottom: 0; left: 0;
  width: 100%; height: 2px;
  background: linear-gradient(90deg,var(--crimson),var(--red2));
  transform: scaleX(0); transform-origin: left; transition: transform .4s;
}
.project-card:hover { border-color: rgba(232,0,10,0.2); }
.project-card:hover::before { opacity: 1; }
.project-card:hover::after { transform: scaleX(1); }
.project-num { font-size: .58rem; color: var(--red2); letter-spacing: .2em; opacity: .5; margin-bottom: 3rem; }
.project-name { font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; letter-spacing: .04em; margin-bottom: .8rem; }
.project-type { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; opacity: .3; }
.project-tag {
  display: inline-block; margin-top: 2rem; padding: .3rem .9rem;
  border: 1px solid rgba(232,0,10,0.2); font-size: .58rem;
  letter-spacing: .15em; text-transform: uppercase; color: var(--red3); opacity: .7;
}

/* PROCESS */
#process { background: rgba(10,3,7,0.85); }
.process-steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; margin-top: 4rem; }
.process-step {
  padding: 3rem 2.5rem; border-left: 1px solid rgba(232,0,10,0.12);
  position: relative; transition: background .4s;
}
.process-step:hover { background: rgba(232,0,10,0.03); }
.step-num { font-family: 'Bebas Neue', sans-serif; font-size: 5rem; color: var(--red2); opacity: .1; line-height: 1; margin-bottom: 1.5rem; }
.step-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: .06em; margin-bottom: 1rem; }
.step-desc { font-size: .68rem; line-height: 1.9; opacity: .38; }

/* TESTIMONIALS */
#testimonials { background: rgba(8,4,7,0.7); min-height: auto; padding: 6rem 3rem; }
.testimonials-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px; margin-top: 4rem; }
.testimonial {
  padding: 2.5rem; background: rgba(15,5,10,0.8);
  border: 1px solid rgba(232,0,10,0.08); transition: border-color .4s;
}
.testimonial:hover { border-color: rgba(232,0,10,0.25); }
.stars { color: var(--red2); margin-bottom: 1rem; font-size: .8rem; letter-spacing: .1em; }
.testimonial-quote { font-size: .78rem; line-height: 1.9; opacity: .55; margin-bottom: 2rem; font-style: italic; }
.testimonial-quote::before { content: '"'; color: var(--red2); font-style: normal; font-size: 1.3rem; }
.testimonial-author { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; }
.testimonial-role { font-size: .58rem; opacity: .35; margin-top: .3rem; }

/* CONTACT */
#contact { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; background: rgba(8,4,7,0.9); }
.contact-form { margin-top: 3rem; }
.form-group { margin-bottom: 1.5rem; }
.form-group label { display: block; font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; opacity: .4; margin-bottom: .6rem; }
.form-group input, .form-group textarea {
  width: 100%; background: rgba(232,0,10,0.04);
  border: 1px solid rgba(232,0,10,0.15); padding: .9rem 1.2rem;
  color: var(--paper); font-family: 'DM Mono', monospace; font-size: .78rem;
  outline: none; transition: border-color .3s, background .3s; resize: none;
}
.form-group input:focus, .form-group textarea:focus { border-color: var(--red2); background: rgba(232,0,10,0.07); }
.form-group textarea { height: 120px; }
.submit-btn {
  display: flex; align-items: center; justify-content: center; gap: 1rem;
  padding: 1rem 2.5rem; background: var(--red); border: none;
  color: var(--paper); font-family: 'DM Mono', monospace;
  font-size: .7rem; letter-spacing: .2em; text-transform: uppercase;
  cursor: none; position: relative; overflow: hidden; width: 100%;
}
.submit-btn::before {
  content: ''; position: absolute; inset: 0; background: var(--red2);
  transform: translateX(-101%); transition: transform .4s;
}
.submit-btn:hover::before { transform: translateX(0); }
.submit-btn span { position: relative; z-index: 1; }
.contact-info { padding-top: 3rem; }
.contact-item { margin-bottom: 2.5rem; }
.contact-item-label { font-size: .58rem; letter-spacing: .25em; text-transform: uppercase; color: var(--red2); opacity: .6; margin-bottom: .5rem; }
.contact-item-val { font-size: .85rem; opacity: .7; }

/* FOOTER */
footer {
  position: relative; z-index: 10; padding: 3rem;
  border-top: 1px solid rgba(232,0,10,0.1); background: rgba(5,2,4,0.95);
  display: flex; justify-content: space-between; align-items: center;
}
.copy { font-size: .6rem; opacity: .25; letter-spacing: .1em; }
.footer-links { display: flex; gap: 2rem; list-style: none; }
.footer-links a { font-size: .6rem; letter-spacing: .15em; text-transform: uppercase; color: var(--paper); text-decoration: none; opacity: .3; transition: opacity .3s, color .3s; }
.footer-links a:hover { opacity: 1; color: var(--red3); }

/* SCROLL HINT */
.scroll-hint {
  position: fixed; right: 2.5rem; bottom: 3rem; z-index: 100;
  writing-mode: vertical-rl; font-size: .58rem; letter-spacing: .25em;
  text-transform: uppercase; opacity: .3; display: flex; align-items: center; gap: 1rem;
  animation: fadeIn 1s ease 3.5s both;
}
.scroll-hint::before {
  content: ''; display: block; width: 1px; height: 50px; background: var(--red2);
  animation: scrollLine 2s ease-in-out infinite;
}

/* REVEAL */
.reveal { opacity: 0; transform: translateY(35px); transition: opacity .8s ease, transform .8s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }

/* KEYFRAMES */
@keyframes fadeUp { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:translateY(0); } }
@keyframes fadeDown { from { opacity:0; transform:translateY(-20px); } to { opacity:1; transform:translateY(0); } }
@keyframes fadeIn { from { opacity:0; } to { opacity:.3; } }
@keyframes scrollLine { 0%,100% { transform:scaleY(1); opacity:1; } 50% { transform:scaleY(.3); opacity:.3; } }
@keyframes marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }
@keyframes loadBar { 0% { width:0; } 70% { width:75%; } 100% { width:100%; } }
@keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:.4; } }
</style>
</head>
